#!name=京东去推荐
#!desc=Surge：拒 QUIC + 可莉规则 + uniformRecommend + 购物车

[Rule]
AND, ((DOMAIN, api.m.jd.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, jd.com), (PROTOCOL, QUIC)), REJECT

[URL Rewrite]
^https://api\.m\.jd\.com/client\.action\?functionId=uniformRecommend\d* - reject-dict
^https://storage\.jd\.com/mpaas2-public/product/[^/]+/recommend_jdur - reject

[Script]
京东去推荐 = type=http-response, pattern=^https://api\.m\.jd\.com/(client\.action|api)\?functionId=(deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome|uniformRecommend\d*|cart\w*|Cart\w*|synCart\w*|shopCart\w*|newCart\w*|getCart\w*), script-path=https://cdn.jsdelivr.net/gh/aoconch/jd-loon-remove-recommend@main/JD_remove_ads.js, requires-body=true, timeout=20

[MITM]
hostname = %APPEND% api.m.jd.com, storage.jd.com
