#!name=京东去推荐
#!desc=Surge：整条 client.action + 拒 QUIC（functionId 常在 body）

[Rule]
AND, ((DOMAIN, api.m.jd.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, jd.com), (PROTOCOL, QUIC)), REJECT

[URL Rewrite]
^https://api\.m\.jd\.com/client\.action\?functionId=uniformRecommend\d* - reject-dict
^https://storage\.jd\.com/mpaas2-public/product/[^/]+/recommend_jdur - reject

[Script]
京东去推荐 = type=http-response, pattern=^https://api\.m\.jd\.com/(client\.action|api), script-path=https://cdn.jsdelivr.net/gh/aoconch/jd-loon-remove-recommend@main/JD_remove_ads.js, requires-body=true, timeout=20

[MITM]
hostname = %APPEND% api.m.jd.com, storage.jd.com, *.jd.com
