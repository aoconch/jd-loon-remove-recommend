#!name=京东去推荐
#!desc=移除消息/购物车/我的/订单/物流底部推荐。匹配整条 client.action（functionId 常在 POST body）。拒 QUIC。
#!author=aoconch
#!homepage=https://github.com/aoconch/jd-loon-remove-recommend
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/JingDong.png
#!category=去广告
#!tag=京东,推荐,去广告

[Rule]
AND, ((DOMAIN, api.m.jd.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, jd.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN, api.m.jd.com), (PROTOCOL, UDP)), REJECT

[Rewrite]
# URL query 形态
^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=uniformRecommend\d* reject-dict
^https:\/\/storage\.jd\.com\/mpaas2-public\/product\/[^\/]+\/recommend_jdur reject-200

[Script]
# 关键：不要只写 ?functionId=，新版京东常把 functionId 放在 body
http-response ^https:\/\/api\.m\.jd\.com\/(client\.action|api) script-path=https://cdn.jsdelivr.net/gh/aoconch/jd-loon-remove-recommend@main/JD_remove_ads.js, requires-body=true, timeout=20, tag=京东去推荐
http-response ^https:\/\/api\.m\.jd\.com\/client\.action script-path=https://kelee.one/Resource/JavaScript/JD/JD_remove_ads.js, requires-body=true, timeout=60, tag=移除京东广告

[Mitm]
hostname = api.m.jd.com, storage.jd.com
