#!name=京东去推荐
#!desc=移除消息/购物车/我的/订单/物流页底部商品推荐。不依赖插件开关；Rewrite 直接 reject，脚本用 jsDelivr。
#!author=aoconch
#!homepage=https://github.com/aoconch/jd-loon-remove-recommend
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/JingDong.png
#!category=去广告
#!tag=京东,推荐,去广告

[Rewrite]
# —— 不依赖外部脚本，直接拦截推荐数据流 ——
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=uniformRecommend\d* reject-dict
^https?:\/\/api\.m\.jd\.com\/client\.action\?[^#]*functionId=uniformRecommend\d* reject-dict
^https?:\/\/api\.m\.jd\.com\/api\?[^#]*functionId=uniformRecommend\d* reject-dict

# recommend_jdur 模板（本地已缓存时仍需配合清缓存）
^https?:\/\/storage\.jd\.com\/mpaas2-public\/product\/[^\/]+\/recommend_jdur reject-200
^https?:\/\/storage\.jd\.com\/mpaas2-public\/product\/[^\/]+\/recommend_ reject-200

[Script]
# 匹配所有 client.action，在脚本内识别 functionId（含 POST body）
http-response ^https?:\/\/api\.m\.jd\.com\/client\.action script-path=https://cdn.jsdelivr.net/gh/aoconch/jd-loon-remove-recommend@main/jd-remove-recommend.js, requires-body=true, timeout=10, tag=京东去推荐
http-response ^https?:\/\/api\.m\.jd\.com\/api\? script-path=https://cdn.jsdelivr.net/gh/aoconch/jd-loon-remove-recommend@main/jd-remove-recommend.js, requires-body=true, timeout=10, tag=京东去推荐-api

[Mitm]
hostname = api.m.jd.com, storage.jd.com
