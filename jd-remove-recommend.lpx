#!name=京东去推荐
#!desc=购物车推荐可能不走 uniformRecommend。MitM 扩大到更多 jd 域名；脚本匹配全部 api.m.jd.com。
#!author=aoconch
#!homepage=https://github.com/aoconch/jd-loon-remove-recommend
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/JingDong.png
#!category=去广告
#!tag=京东,推荐,去广告

[Rule]
AND, ((DOMAIN, api.m.jd.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, jd.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN, api.m.jd.com), (PROTOCOL, UDP)), REJECT

[Rewrite]
^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=uniformRecommend\d* reject-dict
^https:\/\/storage\.jd\.com\/mpaas2-public\/product\/[^\/]+\/recommend_jdur reject-200

[Script]
http-response ^https:\/\/api\.m\.jd\.com\/ script-path=https://raw.githubusercontent.com/aoconch/jd-loon-remove-recommend/main/JD_remove_ads.js, requires-body=true, timeout=20, tag=京东去推荐

[Mitm]
hostname = api.m.jd.com, storage.jd.com, waapdg.jd.com, policy.jd.com, mars.jd.com, api.jd.com, routine.m.jd.com, color.jd.com
